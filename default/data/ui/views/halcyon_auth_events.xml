<!--
=============================================================================
 default/data/ui/views/halcyon_authentication_events.xml
 Halcyon.ai for Splunk App
 Authentication Events
=============================================================================

PURPOSE

Operational visibility into authentication and authorization events
generated by Halcyon.ai.

This dashboard provides:
- User and email filtering
- Authentication result filtering
- Authentication event count summaries
- Success and failure login visibility
- Detailed authentication event inventory
- Authentication activity trending

=============================================================================
-->

<form version="1.1" theme="light">
  <label>🔐 Authentication Events</label>
  <description>Authentication and authorization events generated by Halcyon.ai</description>

  <!-- =============================================================== -->
  <!-- FILTERS                                                         -->
  <!-- =============================================================== -->
  <fieldset submitButton="false">
    <input type="text" token="tok_user">
      <label>👤 User / Email</label>
    </input>

    <input type="dropdown" token="tok_auth_result">
      <label>📌 Result</label>
      <choice value="*">All</choice>
      <choice value="success">Success</choice>
      <choice value="failure">Failure</choice>
      <default>*</default>
    </input>
  </fieldset>

  <!-- =============================================================== -->
  <!-- KPI ROW                                                         -->
  <!-- =============================================================== -->
  <row>
    <panel>
      <single>
        <title>🔐 Total Auth Events</title>
        <search>
          <query>
            index=security_halycon sourcetype="halcyon:auth_event"
            | stats count
          </query>
        </search>
        <option name="underLabel">Events</option>
      </single>
    </panel>

    <panel>
      <single>
        <title>✅ Successful Logins</title>
        <search>
          <query>
            index=security_halycon sourcetype="halcyon:auth_event" result=success
            | stats count
          </query>
        </search>
        <option name="underLabel">Success</option>
      </single>
    </panel>

    <panel>
      <single>
        <title>❌ Failed Logins</title>
        <search>
          <query>
            index=security_halycon sourcetype="halcyon:auth_event" result=failure
            | stats count
          </query>
        </search>
        <option name="underLabel">Failures</option>
      </single>
    </panel>
  </row>

  <!-- =============================================================== -->
  <!-- AUTH EVENT TABLE                                                -->
  <!-- =============================================================== -->
  <row>
    <panel>
      <title>📋 Authentication Events</title>
      <table>
        <search>
          <query>
            index=security_halycon sourcetype="halcyon:auth_event"
            | eval blob=lower(coalesce(user,"")." ".coalesce(email,"")." ".coalesce(ipAddress,""))
            | where ("$tok_auth_result$"="*" OR result="$tok_auth_result$")
            | where ("$tok_user$"="" OR like(blob,"%".lower("$tok_user$")."%"))
            | eval eventTime=strftime(_time,"%Y-%m-%d %H:%M:%S")
            | table eventTime user email result ipAddress userAgent source
            | sort -eventTime
          </query>
        </search>
        <option name="count">50</option>
        <option name="wrap">true</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <!-- =============================================================== -->
  <!-- AUTH TREND                                                      -->
  <!-- =============================================================== -->
  <row>
    <panel>
      <title>📈 Authentication Activity</title>
      <chart>
        <search>
          <query>
            index=security_halycon sourcetype="halcyon:auth_event"
            | timechart span=1h count by result
          </query>
        </search>
        <option name="charting.chart">line</option>
        <option name="legend.placement">right</option>
      </chart>
    </panel>
  </row>

</form>

<!--
=============================================================================
 default/data/ui/views/halycon_navigation.xml
 Halycon.ai for Splunk App
 Navigation Hub
=============================================================================

PURPOSE

Tile-based landing page linking to every functional view.
Section-header tiles (grey, full-width) break the grid into logical
groups. Matches the same “portal tile” design used in the
Documentation Hub.

=============================================================================
-->
<dashboard version="1.1" theme="light">
  <label>📚 Halycon.ai – Navigation Hub</label>

  <row>
    <panel>
      <html>

        <!-- ────────────── tile-grid styles ────────────── -->
        <style>
          .portal-grid{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:22px;
            margin-top:20px;
          }
          .portal-tile{
            background:#ffffff;
            border:1px solid #e5e5e5;
            border-radius:8px;
            padding:22px;
            text-align:center;
            transition:all .18s ease;
          }
          .portal-tile:hover{
            box-shadow:0 4px 14px rgba(0,0,0,.18);
            transform:translateY(-2px);
          }
          .portal-icon{font-size:34px;margin-bottom:10px;}
          .portal-title{font-size:15px;font-weight:600;}
          .portal-link{text-decoration:none;color:inherit;display:block;}

          /* section header tiles (not clickable) */
          .portal-header{
            background:#f5f5f5;
            border:1px solid #d0d0d0;
            cursor:default;
            grid-column:span 4;
            font-size:16px;
            font-weight:700;
            padding:18px 22px;
          }
        </style>

        <!-- ───────────────────  GRID  ─────────────────── -->
        <div class="portal-grid">

          <!-- Overview -->
          <div class="portal-tile portal-header">Overview</div>
          <a class="portal-link" href="halycon_overview">
            <div class="portal-tile"><div class="portal-icon">🧭</div><div class="portal-title">Overview</div></div>
          </a>

          <!-- Alerts -->
          <div class="portal-tile portal-header">Alerts</div>
          <a class="portal-link" href="halycon_alerts">

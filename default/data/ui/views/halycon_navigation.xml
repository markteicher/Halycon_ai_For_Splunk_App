          <a class="portal-link" href="halycon_alert_instances">
            <div class="portal-tile"><div class="portal-icon">🧾</div><div class="portal-title">Alert Instances</div></div>
          </a>

          <!-- Detections -->
          <div class="portal-tile portal-header">Detections</div>
          <a class="portal-link" href="halcyon_detections">
            <div class="portal-tile"><div class="portal-icon">🔎</div><div class="portal-title">Detections</div></div>
          </a>

